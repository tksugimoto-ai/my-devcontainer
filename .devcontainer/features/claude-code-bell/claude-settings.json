{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "AskUserQuestion",
                "hooks": [
                    {
                        "type": "command",
                        "command": "/usr/local/share/claude-code-bell/bell.sh"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "/usr/local/share/claude-code-bell/bell.sh"
                    }
                ]
            }
        ],
        "Notification": [
            {
                "matcher": "permission_prompt|agent_needs_input|elicitation_dialog",
                "hooks": [
                    {
                        "type": "command",
                        "command": "/usr/local/share/claude-code-bell/bell.sh"
                    }
                ]
            }
        ]
    }
}
